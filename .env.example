# Local development
DATABASE_URL=postgresql://katalyst:katalyst@localhost:5432/katalyst?schema=public
REDIS_URL=redis://localhost:6379
# Integration mode:
#   mock  = deterministic offline links (default)
#   live  = all services live (needs every service running)
# Or keep mock and opt specific services into live with LIVE_SERVICES:
INTEGRATION_MODE=mock
LIVE_SERVICES=

WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000
PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
SHORT_URL_BASE=http://localhost:4000/r
DEMO_TENANT_SLUG=demo

# --- Live service credentials (used only when a service is in LIVE_SERVICES) ---
# WordPress: create an Application Password under Users -> Profile.
WORDPRESS_URL=http://localhost:8081
WORDPRESS_USER=admin
WORDPRESS_APP_PASSWORD=

# Nextcloud
NEXTCLOUD_URL=http://localhost:8082
NEXTCLOUD_USER=admin
NEXTCLOUD_PASSWORD=katalyst-admin

# Keycloak (admin REST)
KEYCLOAK_URL=http://localhost:8083
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=master
KEYCLOAK_CLIENT_ID=katalyst-web

# Jitsi (a room exists at this base URL by visiting it)
JITSI_BASE_URL=https://meet.jit.si
